# Garmin Connect credentials. Copy this file to .env and fill in real values.
# .env is gitignored -- never commit real credentials.
GARMIN_EMAIL=your_email@example.com
GARMIN_PASSWORD=your_password

# Optional: where to cache the Garmin session token so you don't have to
# log in with your password every run. Defaults to ~/.garminconnect.
# GARMIN_TOKENSTORE=~/.garminconnect

# Optional: set to true only if you use a Garmin China account.
# GARMIN_IS_CN=false

# Optional: MFA code, if your account has two-factor auth enabled.
# If unset and MFA is required, the script will prompt for it interactively.
# GARMIN_MFA_CODE=
